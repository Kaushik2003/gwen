{
  "name": "gwen-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hub": "VITE_GWEN_TARGET=hub vite build --outDir dist-hub",
